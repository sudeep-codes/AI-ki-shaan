# ==========================================
# AI-ki-shan Environment Configuration
# ==========================================

# Server Configuration (HF Spaces default port is 7860)
HOST=0.0.0.0
PORT=7860
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Telegram Bot Integration
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_ENABLED=true
# Mode: "polling" for local/standalone dev, "webhook" for HF Spaces with custom domain
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=https://your-space-name.hf.space/webhook/telegram

# RAG & Embeddings Configuration (Optimized for 16GB RAM)
# Compact, accurate models:
# - "sentence-transformers/all-MiniLM-L6-v2" (~80MB, fast CPU inference)
# - "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2" (~470MB, Hindi + English support)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=agriculture_knowledge_base

# LLM Providers (Optional: use HF Inference API, Gemini, or OpenAI)
HUGGINGFACE_API_TOKEN=your_hf_token_here
# Model ID on Hugging Face for text generation:
HF_LLM_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.3
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Agriculture Knowledge Settings
DEFAULT_LANGUAGE=en
CONFIDENCE_THRESHOLD=0.65
MAX_RETRIEVED_DOCS=4
